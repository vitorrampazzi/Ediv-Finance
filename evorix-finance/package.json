{
  "name": "ediv-finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "start:api": "node --env-file-if-exists=.env server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "db:migrate:aiven": "node --env-file=.env --env-file=.env.aiven server/migrate-aiven.js",
    "db:transfer:aiven": "node --env-file=.env --env-file=.env.aiven server/transfer-aiven.js",
    "db:bootstrap:aiven-app": "node --env-file=.env --env-file=.env.aiven server/bootstrap-aiven-app.js",
    "dev:api:aiven": "node --watch --env-file=.env.aiven.runtime server/index.js",
    "dev:api:qa": "node --watch --env-file=.env.qa server/index.js",
    "db:provision:qa": "node --env-file=.env.aiven server/provision-qa.js",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "test": "node --test tests/unit.test.mjs tests/site.test.mjs tests/portfolio-insights.test.mjs",
    "test:integration:aiven": "node --env-file=.env.aiven tests/integration.test.mjs",
    "test:browser:aiven": "node --env-file=.env.aiven tests/run-browser.mjs",
    "test:production": "node tests/production-smoke.mjs",
    "test:backup:aiven": "node --env-file=.env.aiven tests/backup.mjs",
    "preview": "vite preview",
    "db:backup:aiven": "node --env-file=.env.aiven.runtime --env-file=.env.backup server/backup.js backup",
    "db:restore": "node --env-file=.env.restore --env-file=.env.backup server/backup.js restore",
    "access:preserve-team:aiven": "node --env-file=.env.aiven.runtime server/setup-access.js legacy",
    "access:grant-admin:aiven": "node --env-file=.env.aiven.runtime server/setup-access.js admin",
    "test:integration": "node tests/integration.test.mjs",
    "test:browser": "node tests/run-browser.mjs",
    "test:backup": "node tests/backup.mjs",
    "export:source": "node scripts/export-source.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fflate": "^0.8.3",
    "framer-motion": "^13.4.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.46.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "playwright": "1.62.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
