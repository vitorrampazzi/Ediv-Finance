NODE_ENV=development
PORT=3001

# MySQL credentials. Keep real values in your local .env file, never in Git.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=evorix
MYSQL_USER=evorix_app
MYSQL_PASSWORD=change_this_locally
MYSQL_SSL=false

# Optional in development. Production migration jobs should use a separate
# database account with DDL permission and keep its password out of the API.
# MYSQL_MIGRATION_USER=
# MYSQL_MIGRATION_PASSWORD=

# The browser app's origin and base URL, without a trailing slash.
APP_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Required to send verification emails in production.
SMTP_URL=
MAIL_FROM=

# Set true only when the API is behind your own trusted reverse proxy.
TRUST_PROXY=false
