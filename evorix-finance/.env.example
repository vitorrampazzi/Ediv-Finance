NODE_ENV=development
PORT=3001

# MySQL credentials. Keep real values in your local .env file, never in Git.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=evorix_finance
MYSQL_USER=evorix_app
MYSQL_PASSWORD=change_this_locally
MYSQL_SSL=false
MYSQL_SSL_CA=
MYSQL_SSL_CA_FILE=
MYSQL_CONNECTION_LIMIT=10

# Local development migration account (DDL is separate from the runtime API user).
MYSQL_MIGRATION_USER=evorix_migrator
MYSQL_MIGRATION_PASSWORD=change_this_migration_password_locally

# The browser app's origin and base URL, without a trailing slash.
APP_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Required to send verification emails in production.
SMTP_URL=
MAIL_FROM=

# Set true only when the API is behind your own trusted reverse proxy.
TRUST_PROXY=false

# Optional. Keep market data provider credentials on the server, never in the browser.
BRAPI_API_KEY=

# Optional experimental educational assistant. Create a Gemini API key in Google AI Studio.
# Keep billing disabled for the free tier, and never send personal or portfolio data.
# QA enables the assistant automatically. Local main can opt in for development only.
# Vercel Production always blocks it, regardless of these variables.
EDIV_ASSISTANT_PREVIEW=false
AI_ASSISTANT_ENABLED=false
AI_DAILY_LIMIT=100
AI_USER_DAILY_LIMIT=20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Lista antiga: usada uma única vez pelo comando setup-access.js legacy.
# Novos acessos são gerenciados pelo Administrador em /app/admin, no banco.
RANKING_ADMIN_EMAILS=

# Dados públicos opcionais. Deixe vazios enquanto não forem definidos.
SUPPORT_EMAIL=
SUPPORT_HOURS=
PROFESSIONAL_NAME=
PROFESSIONAL_CATEGORY=
PROFESSIONAL_REGISTRATION=
